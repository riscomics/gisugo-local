// ⚠️  DEPLOYMENT REQUIRED after ANY edit to this file.
// Run: firebase deploy --only firestore:rules
// Last deployed: 2026-02-20
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════════
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is the owner of a resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Safe numeric coercion helpers for optional fields.
    function intOrZero(value) {
      return value is int ? value : 0;
    }

    function numberOrZero(value) {
      return value is number ? value : 0;
    }
    
    // Check if user is admin.
    // Membership lives in the `admins` collection (doc ID = uid), not a
    // hardcoded email list — accounts can sign in with multiple providers
    // (Google/Facebook/phone+password) and the "primary" email on the auth
    // token can vary between them, so uid is the only stable identifier.
    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Full admin powers (e.g. Settings, granting/revoking other admins),
    // as opposed to a future limited "support" role (gig/user moderation +
    // support replies only).
    function isSuperAdmin() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }
    
    // Validate profile data structure
    function isValidProfile() {
      return request.resource.data.keys().hasAll(['userId', 'fullName', 'email', 'accountCreated'])
        && request.resource.data.userId is string
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 100;
    }
    
    // Validate job data structure
    function isValidJob() {
      return request.resource.data.keys().hasAll(['posterId', 'title', 'category', 'region', 'city'])
        && request.resource.data.posterId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 55
        && request.resource.data.category is string
        && request.resource.data.region is string
        && request.resource.data.city is string;
    }
    
    // Validate application data
    function isValidApplication() {
      return request.resource.data.keys().hasAll(['jobId', 'applicantId'])
        && request.resource.data.jobId is string
        && request.resource.data.applicantId is string
        && request.resource.data.applicantId == request.auth.uid;
    }
    
    // Check if only application-related fields are being updated (for workers applying)
    function onlyUpdatingApplicationFields() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['applicationCount', 'applicationIds']);
    }
    
    // Check if hired worker is rejecting the offer (reverting to active status)
    function isHiredWorkerRejectingOffer() {
      return resource.data.status == 'hired'
        && resource.data.hiredWorkerId == request.auth.uid
        && request.resource.data.status == 'active';
    }
    
    // Check if hired worker is accepting the offer (changing to accepted status)
    function isHiredWorkerAcceptingOffer() {
      return resource.data.status == 'hired'
        && resource.data.hiredWorkerId == request.auth.uid
        && request.resource.data.status == 'accepted';
    }
    
    // Check if hired worker is resigning from the job (after accepting)
    function isHiredWorkerResigning() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return (resource.data.status == 'hired' || resource.data.status == 'accepted')
        && resource.data.hiredWorkerId == request.auth.uid
        && request.resource.data.status == 'active'
        && affectedKeys.hasOnly([
          'status', 'hiredWorkerId', 'hiredWorkerName', 'hiredWorkerThumbnail',
          'agreedPrice', 'hiredAt', 'acceptedAt', 'resignedAt', 'resignReason',
          'resignedWorkerId', 'resignedWorkerName', 'applicationCount', 'lastModified'
        ]);
    }
    
    // Check if customer is marking their hired job as complete
    function isCustomerMarkingComplete() {
      return resource.data.status == 'accepted'
        && resource.data.posterId == request.auth.uid
        && request.resource.data.status == 'completed';
    }
    
    // Check if only updating statistics fields (for job completion)
    function isUpdatingStatistics() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let oldWorkerCompleted = intOrZero(resource.data.statistics.worker.totalGigsCompleted);
      let newWorkerCompleted = intOrZero(request.resource.data.statistics.worker.totalGigsCompleted);
      let oldCustomerCompleted = intOrZero(resource.data.statistics.customer.totalGigsCompleted);
      let newCustomerCompleted = intOrZero(request.resource.data.statistics.customer.totalGigsCompleted);
      let oldWorkerEarned = numberOrZero(resource.data.statistics.worker.totalEarned);
      let newWorkerEarned = numberOrZero(request.resource.data.statistics.worker.totalEarned);
      let oldCustomerSpent = numberOrZero(resource.data.statistics.customer.totalSpent);
      let newCustomerSpent = numberOrZero(request.resource.data.statistics.customer.totalSpent);

      return affectedKeys.hasOnly(['statistics'])
        && request.resource.data.statistics is map
        && newWorkerCompleted >= oldWorkerCompleted
        && newCustomerCompleted >= oldCustomerCompleted
        && newWorkerEarned >= oldWorkerEarned
        && newCustomerSpent >= oldCustomerSpent
        // Completed gig counts should only move by one per update.
        && (newWorkerCompleted - oldWorkerCompleted) <= 1
        && (newCustomerCompleted - oldCustomerCompleted) <= 1;
    }
    
    // Check if only updating review-related fields (for review submission)
    function isUpdatingReviewStats() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let oldTotalReviews = intOrZero(resource.data.totalReviews);
      let newTotalReviews = intOrZero(request.resource.data.totalReviews);

      return affectedKeys.hasOnly(['averageRating', 'totalReviews', 'lastReviewAt'])
        && request.resource.data.averageRating is number
        && request.resource.data.averageRating >= 1
        && request.resource.data.averageRating <= 5
        && request.resource.data.totalReviews is int
        // Review count can only advance by one per submitted review update.
        && newTotalReviews == oldTotalReviews + 1;
    }
    
    // Check if customer is updating their job with review data
    function isCustomerSubmittingReview() {
      return resource.data.posterId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customerFeedbackSubmitted', 
          'customerFeedbackAt', 
          'customerRating',
          'customerFeedback'
        ]);
    }
    
    // Check if worker is updating their job with review data
    function isWorkerSubmittingReview() {
      return resource.data.hiredWorkerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'workerFeedbackSubmitted',
          'workerFeedbackAt',
          'workerRating',
          'workerFeedback'
        ]);
    }
    
    // ═══════════════════════════════════════════════════════════════
    // ADMINS COLLECTION (Dashboard access control)
    // Doc ID = uid. Presence in this collection = admin access; the `role`
    // field distinguishes full ("super_admin") vs a future limited role.
    // Bootstrapping the very first admin(s) happens via the Admin SDK
    // (scripts/), which bypasses these rules entirely — everything below
    // only governs client-side access after that.
    // ═══════════════════════════════════════════════════════════════
    match /admins/{adminId} {
      // Own doc: so a cold tab can check membership without the circular
      // `isAdmin()` (exists(admins/uid) + allow read only if isAdmin).
      // Other admins can still list the collection for a future admin UI.
      allow read: if isAuthenticated()
        && (request.auth.uid == adminId || isAdmin());

      // Only an existing super admin can grant/revoke admin access —
      // never a client granting itself, and never a non-super admin.
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // USERS COLLECTION
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId} {
      // Anyone can read any user profile (for displaying poster info, etc.)
      allow read: if true;
      
      // Only authenticated users can create their own profile
      allow create: if isAuthenticated() 
        && request.auth.uid == userId 
        && isValidProfile()
        && request.resource.data.userId == userId;
      
      // Only the owner can update their own profile
      // OR authenticated users can update statistics (for job completion)
      // OR authenticated users can update review stats (averageRating, totalReviews)
      // Owner is explicitly blocked from touching moderation fields (status/
      // suspend*/reinstate*/banned*/unbanned*) -- otherwise a suspended or
      // banned user could just save their own profile again to quietly
      // clear their own moderation. Those fields are admin-only, written
      // exclusively via the adminModerateUser callable (Admin SDK, bypasses
      // these rules). See functions/index.js.
      allow update: if (isOwner(userId)
        && isValidProfile()
        && request.resource.data.userId == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['status', 'suspendedAt', 'suspendedBy', 'suspendedByName', 'suspendReason', 'reinstatedAt', 'reinstatedBy', 'bannedAt', 'bannedBy', 'bannedByName', 'unbannedAt', 'unbannedBy']))
        || (isAuthenticated() && isUpdatingStatistics())
        || (isAuthenticated() && isUpdatingReviewStats());
      
      // Only the owner or admin can delete
      allow delete: if isOwner(userId) || isAdmin();

      // Per-device push registration tokens for this user.
      match /notificationTokens/{tokenId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // USER_PRIVATE COLLECTION (Owner-only sensitive profile metadata)
    // ═══════════════════════════════════════════════════════════════
    match /user_private/{userId} {
      // Only owner (or admin) can read/write private profile metadata.
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /security_metadata/{userId} {
      // Signup GPS coordinates/region + signup IP (Trust & Safety: ban-evasion
      // / multi-accounting detection). Deliberately admin-only, NOT
      // owner-readable like user_private -- the whole point of recording an
      // IP is as independent evidence, so the account itself must never be
      // able to read or (especially) overwrite its own copy. Written only by
      // the submitSignupLocation Cloud Function via the Admin SDK, which
      // bypasses these rules entirely -- no client write path exists or is
      // needed. (An owner-facing "download my data" export, if ever built,
      // would go through its own Cloud Function, not a rules change here.)
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // ═══════════════════════════════════════════════════════════════
    // JOBS COLLECTION
    // ═══════════════════════════════════════════════════════════════
    match /jobs/{jobId} {
      // Anyone can read all jobs (for browsing listings)
      allow read: if true;
      
      // Only authenticated users can create jobs
      allow create: if isAuthenticated()
        && isValidJob()
        && request.resource.data.posterId == request.auth.uid;
      
      // Job poster can update their own job
      // OR any authenticated user can increment applicationCount (when applying)
      // OR hired worker can reject the offer (revert to active)
      // OR hired worker can accept the offer (change to accepted)
      // OR hired worker can resign from the job (after accepting, revert to active)
      // OR customer can mark accepted job as completed
      // OR customer can submit review for completed job
      // OR worker can submit review for completed job
      //
      // Gig Moderation guardrails (Admin Dashboard Phase 2): a 'reported' or
      // 'suspended' gig is frozen for every client-side path (including the
      // poster) in BOTH directions -- can't already be in that state and
      // get touched, and can't be moved INTO that state -- only the
      // adminModerateGig Cloud Function (and the report-counter trigger,
      // for reported) can, since Admin SDK writes bypass these rules
      // entirely. Checking both resource.data (before) and
      // request.resource.data (after) matters here: checking only "after"
      // would also block a harmless unrelated field update (e.g. an
      // applicationCount bump) on a gig that's already sitting in
      // 'reported', since its status value stays 'reported' either way.
      // reportCount/reportThreshold are likewise admin/Cloud-Function-only,
      // which is what stops a reported poster from quietly un-reporting or
      // un-suspending their own gig.
      allow update: if isAuthenticated()
        && !(resource.data.status in ['reported', 'suspended'])
        && !(request.resource.data.status in ['reported', 'suspended'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reportCount', 'reportThreshold'])
        && (resource.data.posterId == request.auth.uid
            || onlyUpdatingApplicationFields()
            || isHiredWorkerRejectingOffer()
            || isHiredWorkerAcceptingOffer()
            || isHiredWorkerResigning()
            || isCustomerMarkingComplete()
            || isCustomerSubmittingReview()
            || isWorkerSubmittingReview());
      
      // Only the job poster or admin can delete
      allow delete: if isAuthenticated()
        && (resource.data.posterId == request.auth.uid || isAdmin());
    }
    
    // ═══════════════════════════════════════════════════════════════
    // APPLICATIONS COLLECTION
    // ═══════════════════════════════════════════════════════════════
    match /applications/{applicationId} {
      // Users can read their own applications
      // Note: Job posters will query by jobId, so we allow reads for authenticated users
      // and rely on client-side filtering by jobId
      allow read: if isAuthenticated();
      
      // Authenticated users can create applications (but not to their own jobs)
      allow create: if isAuthenticated()
        && isValidApplication()
        && request.resource.data.applicantId == request.auth.uid
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.posterId != request.auth.uid;
      
      // Job poster can update application status (hired/rejected)
      // Applicant can update their own application (withdraw, etc.)
      allow update: if isAuthenticated()
        && (resource.data.applicantId == request.auth.uid
            || get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.posterId == request.auth.uid);
      
      // Applicant or job poster can delete
      allow delete: if isAuthenticated()
        && (resource.data.applicantId == request.auth.uid 
            || get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.posterId == request.auth.uid);
    }
    
    // ═══════════════════════════════════════════════════════════════
    // JOB DELETIONS COLLECTION (Audit Log)
    // ═══════════════════════════════════════════════════════════════
    match /job_deletions/{deletionId} {
      // Only admins can read audit logs
      allow read: if isAdmin();
      
      // System can create (through client for now, ideally Cloud Function)
      allow create: if isAuthenticated();
      
      // No updates or deletes allowed (immutable audit trail)
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // JOB MODERATION LOG COLLECTION (Audit Log — Gig Moderation Phase 2)
    // ═══════════════════════════════════════════════════════════════
    match /job_moderation_log/{logId} {
      // Only admins can read the moderation audit trail.
      allow read: if isAdmin();

      // Written only by the adminModerateGig Cloud Function via the Admin
      // SDK, which bypasses these rules entirely — no client write path
      // exists or is needed (mirrors job_deletions' immutable-trail intent,
      // but stricter: no client `create` either, since this one only ever
      // needs to be written by an already-verified admin action).
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // USER MODERATION LOG COLLECTION (Audit Log — User Management Phase 3)
    // ═══════════════════════════════════════════════════════════════
    match /user_moderation_log/{logId} {
      // Only admins can read the moderation audit trail.
      allow read: if isAdmin();

      // Written only by the adminModerateUser Cloud Function via the Admin
      // SDK, which bypasses these rules entirely. See functions/index.js.
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // ORPHANED FILES COLLECTION (Future Feature)
    // ═══════════════════════════════════════════════════════════════
    match /orphaned_files/{fileId} {
      // Only admins can read
      allow read: if isAdmin();
      
      // System can create
      allow create: if isAuthenticated();
      
      // Only admins can update/delete
      allow update, delete: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════════════════
    // REVIEWS COLLECTION
    // ═══════════════════════════════════════════════════════════════
    match /reviews/{reviewId} {
      // Anyone can read reviews (public for profile display)
      allow read: if true;
      
      // Only authenticated users can create reviews for completed jobs
      // Customer reviews worker, or worker reviews customer
      allow create: if isAuthenticated()
        && request.resource.data.reviewerUserId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'reviewId', 'jobId', 'reviewerUserId', 'revieweeUserId',
          'reviewerRole', 'revieweeRole', 'rating', 'feedbackText'
        ])
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      
      // Only the review author can update their own review
      allow update: if isAuthenticated()
        && resource.data.reviewerUserId == request.auth.uid;
      
      // Only the review author or admin can delete
      allow delete: if isAuthenticated()
        && (resource.data.reviewerUserId == request.auth.uid || isAdmin());
    }
    
    // ═══════════════════════════════════════════════════════════════
    // MESSAGES/CHAT COLLECTION (Future Feature)
    // ═══════════════════════════════════════════════════════════════
    match /messages/{messageId} {
      // Users can only read messages they're part of
      allow read: if isAuthenticated()
        && (resource.data.senderId == request.auth.uid 
            || resource.data.receiverId == request.auth.uid);
      
      // Authenticated users can create messages
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid;
      
      // No updates or deletes (messages are immutable)
      allow update, delete: if false;
    }
    
    // ═══════════════════════════════════════════════════════════════
    // NOTIFICATIONS COLLECTION (ALERTS Tab in Messages)
    // Cross-user writes are intentional: applicants create notifications
    // for job posters, customers create notifications for workers, etc.
    // ═══════════════════════════════════════════════════════════════
    match /notifications/{notificationId} {
      // Authenticated users can read any notification.
      // This is required so the system can query existing notifications
      // for another user (e.g., checking if a job already has an
      // application_received notification before creating a new one).
      allow read: if isAuthenticated();
      
      // Any authenticated user can create a notification for any recipient.
      // Necessary because notifications are created cross-user client-side.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['recipientId', 'type', 'message'])
        && request.resource.data.recipientId is string
        && request.resource.data.type is string;
      
      // Authenticated users can update notifications (mark as read, milestone updates).
      allow update: if isAuthenticated();
      
      // Any authenticated user can delete (needed for duplicate cleanup and
      // removing stale offer notifications on accept/reject).
      allow delete: if isAuthenticated();
    }

    // ═══════════════════════════════════════════════════════════════
    // GIG REPORTS COLLECTION (Gig Page -> Report Gig)
    // ═══════════════════════════════════════════════════════════════
    match /gig_reports/{reportId} {
      // Reporter can read own reports. Admin can read all reports.
      allow read: if isAuthenticated()
        && (resource.data.reporterId == request.auth.uid || isAdmin());

      // Authenticated users can create one report document per gig/user pair.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll([
          'reportId', 'jobId', 'reporterId', 'subject', 'message'
        ])
        && request.resource.data.reportId is string
        && request.resource.data.jobId is string
        && request.resource.data.reporterId is string
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.reporterId == request.auth.uid;

      // Reports are immutable for reporters. Admin can update moderation status.
      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // CHAT THREADS + CHAT MESSAGES (User Chats)
    // ═══════════════════════════════════════════════════════════════
    match /chat_threads/{threadId} {
      // Only participants in a thread can read it.
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participantIds;

      // Authenticated users can create a thread only if they are one of the participants.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['participantIds', 'jobId'])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] is string
        && request.resource.data.participantIds[1] is string
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && request.resource.data.jobId is string
        && request.auth.uid in request.resource.data.participantIds;

      // Only participants can update active thread metadata (lastMessage, unread counters, etc.).
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.jobId == resource.data.jobId;

      // Thread deletion disabled for now (use soft-delete/isActive).
      allow delete: if false;
    }

    match /chat_messages/{messageId} {
      // A user can read messages only for threads they participate in.
      allow read: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/chat_threads/$(resource.data.threadId)).data.participantIds;

      // Sender must be authenticated and belong to the target thread.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['threadId', 'senderId', 'content'])
        && request.resource.data.threadId is string
        && request.resource.data.senderId is string
        && request.resource.data.content is string
        && request.resource.data.senderId == request.auth.uid
        && get(/databases/$(database)/documents/chat_threads/$(request.resource.data.threadId)).data.isActive == true
        && request.auth.uid in get(/databases/$(database)/documents/chat_threads/$(request.resource.data.threadId)).data.participantIds;

      // Messages are immutable for now.
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SUPPORT REQUESTS (Public contact form + in-app support)
    // ═══════════════════════════════════════════════════════════════
    match /support_requests/{requestId} {
      // Requester can read own ticket. Admin can read all.
      allow read: if isAdmin()
        || (isAuthenticated()
            && resource.data.requester is map
            && resource.data.requester.userId is string
            && resource.data.requester.userId == request.auth.uid);

      // Create allowed for authenticated users and guests.
      // Authenticated users must write their own UID as requester.userId.
      // Guests must keep requester.userId as null.
      allow create: if request.resource.data.keys().hasAll([
            'source', 'messageType', 'channel', 'categoryCode', 'categoryLabel',
            'subject', 'message', 'requester', 'status', 'referenceId'
          ])
        && request.resource.data.source is string
        && request.resource.data.messageType is string
        && request.resource.data.channel is string
        && request.resource.data.categoryCode is string
        && request.resource.data.categoryLabel is string
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.requester is map
        && request.resource.data.requester.keys().hasAll(['userId', 'name', 'email'])
        && request.resource.data.requester.name is string
        && request.resource.data.requester.email is string
        && request.resource.data.status == 'pending'
        && request.resource.data.referenceId is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && (
          (isAuthenticated()
            && request.resource.data.requester.userId is string
            && request.resource.data.requester.userId == request.auth.uid)
          || (!isAuthenticated() && request.resource.data.requester.userId == null)
        );

      // Admin can manage lifecycle/reply fields only -- NOT the requester's original
      // submission content (subject/message/requester/categoryCode/referenceId stay
      // immutable once created, same discipline as jobs.status locking in Phase 2).
      // Phase 10: `messages` + `lastSender` are the thread engine. Admins may
      // write them from the dashboard. Requesters still cannot -- user appends
      // go through the appendSupportUserMessage callable (Admin SDK), so a
      // client cannot rewrite earlier entries in the list.
      // Requesters can only mark their own ticket as read.
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status', 'reply', 'messages', 'lastSender', 'assignedTo', 'priority',
             'isReadByRequester', 'updatedAt', 'updatedAtISO', 'updatedAtMs',
             'lastUpdatedAt', 'lastUpdatedAtISO', 'lastUpdatedAtMs']))
        || (isAuthenticated()
            && resource.data.requester is map
            && resource.data.requester.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReadByRequester', 'updatedAt', 'updatedAtISO', 'updatedAtMs']));

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // PLATFORM BROADCASTS (Admin → All Users, e.g. System/Platform Updates, Promotions)
    // ═══════════════════════════════════════════════════════════════
    match /platform_broadcasts/{broadcastId} {
      // Any signed-in user can read broadcasts in their Support/Messages inbox.
      allow read: if isAuthenticated();

      // Only admins can send one, and only with a valid shape. Immutable once sent
      // (no update path) -- "Unsend" is a real delete, not an edit.
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['category', 'subject', 'message', 'sentBy', 'createdAt'])
        && request.resource.data.category in ['important-notices', 'platform-updates', 'system-updates', 'promotions']
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.sentBy is map
        && request.resource.data.sentBy.adminId == request.auth.uid;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // PLATFORM ANALYTICS (Admin Dashboard — cheap counter docs)
    // ═══════════════════════════════════════════════════════════════
    match /platform_analytics/{docId} {
      // Admin dashboard reads these small aggregate docs instead of scanning
      // jobs/applications directly. Only Cloud Functions (Admin SDK, bypasses
      // rules) ever write here — no client write path needed or allowed.
      allow read: if isAdmin();
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // PLATFORM SETTINGS (Admin Dashboard — Phase 5)
    // ═══════════════════════════════════════════════════════════════
    match /platform_settings/{docId} {
      // Admin-only read (tightened 2026-08-11): this used to be public read
      // because index.html's homepage video gate (`showHomepageVideoForLoggedIn`)
      // read this doc for every visitor, logged in or not. That field/feature
      // was removed (replaced by a zero-cost code-level video swap in
      // index.html — see HOME_VIDEO_LOGGED_OUT/HOME_VIDEO_LOGGED_IN there), so
      // there is no longer any public-facing consumer of this doc — only the
      // Admin Dashboard reads it now. Narrowed to isAdmin(), same tier as
      // platform_analytics, since these are internal config values with no
      // remaining reason for anonymous/public exposure.
      allow read: if isAdmin();

      // Only a super admin can change platform-wide settings — same "full
      // admin powers" tier as granting/revoking other admins (see isSuperAdmin()).
      allow write: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // AD SETTINGS (Admin Dashboard — Phase 6)
    // One public config doc (adSettings/global). Category / profile /
    // gig-detail pages are public, so read is open. Write is admin-only.
    // One-shot .get() — no listener. Not impression/click counters.
    // ═══════════════════════════════════════════════════════════════
    match /adSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // DENY ALL OTHER COLLECTIONS BY DEFAULT
    // ═══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
