rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Same source of truth as firestore.rules: an admins/{uid} doc.
    // The old custom-claim check (request.auth.token.admin == true) was
    // never stamped on login, so every Storage isAdmin() path was dead --
    // including admin reply photos on support_photos/{requesterId}/...
    // (admin is not the requester, so isOwner() also fails).
    function isAdmin() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Public profile photos (marketplace-facing avatars)
    match /profile_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isOwner(userId) || isAdmin();
    }

    // Public job photos (listing thumbnails and gig images)
    match /job_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isOwner(userId) || isAdmin();
    }

    // Sensitive ID docs (owner/admin only)
    match /verification_ids/{userId}/{allPaths=**} {
      allow read, write, delete: if isOwner(userId) || isAdmin();
    }

    // Dedicated Face Verification media namespace (owner/admin only)
    match /face_verification/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if isOwner(userId) || isAdmin();
    }

    // Contact attachments (authenticated users)
    match /contacts/{allPaths=**} {
      allow read, write, delete: if isAuthenticated();
    }

    // Support ticket attachment photos (uploaded via support.html's "Contact
    // Us" compose form -- see uploadSupportPhoto() in firebase-storage.js).
    // FIX (2026-08-12): this path had no rule at all, so every upload hit
    // the catch-all deny below and failed silently -- support tickets with a
    // photo attached could never actually send. Path is
    // support_photos/{requesterId}/{referenceId}.jpg where requesterId is
    // the submitter's own uid (the compose form requires login before
    // submitting, so this is never a guest/anonymous uid in practice).
    // Owner can read/write their own; admin can read for the Support queue.
    match /support_photos/{requesterId}/{allPaths=**} {
      allow read: if isOwner(requesterId) || isAdmin();
      allow write, delete: if isOwner(requesterId) || isAdmin();
    }

    // Chat photos (strict participant-scoped access)
    // Path format: chat_photos/{threadId}/{uidA}/{uidB}/{file}
    match /chat_photos/{threadId}/{uidA}/{uidB}/{allPaths=**} {
      allow read, write, delete: if isAuthenticated()
        && (request.auth.uid == uidA || request.auth.uid == uidB)
        || isAdmin();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
