rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Same source of truth as firestore.rules: an admins/{uid} doc.
    // The old custom-claim check (request.auth.token.admin == true) was
    // never stamped on login, so every Storage isAdmin() path was dead --
    // including admin reply photos on support_photos/{requesterId}/...
    // (admin is not the requester, so isOwner() also fails).
    function isAdmin() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Public profile photos (marketplace-facing avatars)
    match /profile_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isOwner(userId) || isAdmin();
    }

    // Public job photos (listing thumbnails and gig images)
    match /job_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isOwner(userId) || isAdmin();
    }

    // Sensitive ID docs (owner/admin only)
    match /verification_ids/{userId}/{allPaths=**} {
      allow read, write, delete: if isOwner(userId) || isAdmin();
    }

    // Dedicated Face Verification media namespace (owner/admin only)
    match /face_verification/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if isOwner(userId) || isAdmin();
    }

    // Contact attachments (authenticated users)
    match /contacts/{allPaths=**} {
      allow read, write, delete: if isAuthenticated();
    }

    // Support ticket photos. Path is support_photos/{uploaderId}/...
    // Write: only the signed-in uploader's own folder (user compose AND
    // admin reply). Do not depend on isAdmin() here -- Storage's
    // firestore.exists(admins/{uid}) was still 403ing live on 2026-08-14
    // after that lookup was added. Read: any signed-in user, so the other
    // party can see the photo in the thread (download URLs are already
    // stored on the ticket).
    match /support_photos/{uploaderId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if isOwner(uploaderId);
    }

    // Chat photos (strict participant-scoped access)
    // Path format: chat_photos/{threadId}/{uidA}/{uidB}/{file}
    match /chat_photos/{threadId}/{uidA}/{uidB}/{allPaths=**} {
      allow read, write, delete: if isAuthenticated()
        && (request.auth.uid == uidA || request.auth.uid == uidB)
        || isAdmin();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
